rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // 🔐 HELPER FUNCTIONS
    // ==========================================================
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    function isNotSuspended() {
      // A suspended account keeps a perfectly valid Firebase Auth session
      // (suspension is an admin-set Firestore flag, not a revoked
      // credential) - see app.py's _check_not_suspended for the matching
      // backend-side check. This is what closes the same gap for any
      // direct Firestore client access that bypasses the backend
      // entirely. Admins are never suspendable (enforced server-side in
      // admin_suspend_user), so this never needs to gate isAdmin().
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuspended != true;
    }
    
    function isAuthenticated() {
      return request.auth != null && isNotSuspended();
    }
    
    function isOwnProfile(userId) {
      return request.auth != null && request.auth.uid == userId && isNotSuspended();
    }
    
    function isStudent() {
      return request.auth != null && !isAdmin();
    }

    function isApprovedTeacher() {
      return request.auth != null && isNotSuspended()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.approved == true;
    }

    // ==========================================================
    // 👤 USERS (ተምሃሮ)
    // ==========================================================
    match /users/{userId} {
      allow read: if isAdmin() || isOwnProfile(userId);
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'class', 'registeredAt', 'progress',
          'payments', 'isAdmin', 'profileImage', 'bio', 'freeTrial', 'isPaid', 'accountType'
        ])
        && request.resource.data.isAdmin == false
        && request.resource.data.isPaid == false
        && request.resource.data.accountType in ['student', 'teacher', 'parent']
        && request.resource.data.payments == []
        && request.resource.data.freeTrial.isActive == true
        && request.resource.data.freeTrial.usedDays == 0;
      // Students may edit only ordinary profile/progress fields.
      // Payment/subscription/admin/identity fields are server-authoritative.
      allow update: if isAdmin() || (
        isOwnProfile(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'bio', 'profileImage', 'progress'
        ])
      );
      allow delete: if isAdmin();
    }

    // ==========================================================
    // 📚 BOOKS (መፃሕፍቲ)
    // ==========================================================
    match /books/{bookId} {
      // V31.108: student.js no longer reads this collection directly with
      // the client SDK - it now goes through GET /api/library, which
      // applies the real grade + Learning Mode/Audience authorization
      // server-side (see content_visible_or_untargeted in
      // targeting_access.py). Direct client reads are closed entirely,
      // matching the same fix already applied to /courses, /lessons and
      // /exams in this file.
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Additional Digital Library categories (same access pattern as /books).
    match /bookLibrary/{bookId} {
      // V31.108: see /books above - same fix, same reasoning.
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /teacherGuides/{bookId} {
      // V31.108: see /books above - same fix, same reasoning.
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /referenceBooks/{bookId} {
      // V31.108: see /books above - same fix, same reasoning.
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /psychologyBooks/{bookId} {
      // V31.108: see /books above - same fix, same reasoning.
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================================
    // 🎥 VIDEOS (ቪድዮታት)
    // ==========================================================
    match /videos/{videoId} {
      // Video metadata/URLs are server-authoritative. The browser receives
      // only videos it is entitled to through /api/videos.
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================================
    // 🧠 SMART QUIZ SCANNER — server-authoritative OCR/review/import
    // ==========================================================
    match /smartQuizScans/{scanId} {
      // Scan files, OCR drafts and answer keys are server-managed.
      allow read, create, update, delete: if false;
    }

    // ==========================================================
    // ✍️ QUIZZES (ፈተናታት)
    // ==========================================================
    match /quizzes/{quizId} {
      // Quiz documents contain answer keys. Students receive sanitized
      // questions through /api/quizzes and never read this collection directly.
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================================
    // 📊 QUIZ RESULTS (ውፅኢት ፈተና)
    // ==========================================================
    match /quizResults/{resultId} {
      // Quiz results are calculated and written by Flask/Admin SDK.
      // The browser must never be able to forge score or percentage.
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ==========================================================
    // 📡 LIVE STREAM SETTINGS
    // ==========================================================
    match /settings/{settingId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================================
    // 👨‍🏫 TEACHER REQUESTS — previously had NO rules at all,
    // which means Firestore denied everyone by default (including
    // admin). Locked to admin-only for now since there's no public
    // "apply to teach" form yet.
    // ==========================================================
    match /teacherRequests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /teachers/{teacherId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ==========================================================
    // 💬 CHAT (ቻት)
    // ==========================================================
    match /chats/{chatId} {
      // BMT Community Chat: authenticated students, approved teachers and admins
      // can participate in the shared room. Legacy class chats remain class-scoped.
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.chatRoom == 'community' ||
          resource.data.className == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.class
        )
      );
      // Community messages are written only through Flask/Admin SDK so sender
      // role, media URL and reply metadata cannot be forged in the browser.
      allow create: if isAuthenticated()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.className is string
        && request.resource.data.chatRoom != 'community'
        && request.resource.data.className == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.class;
      // Browser clients may only update the read flag. Message content/replies
      // and reactions are server-authoritative to prevent forged writes.
      allow update: if isAdmin() || (
        isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead == true
      );
      allow delete: if isAdmin();
    }

    // ==========================================================
    // 💳 PAYMENTS (ክፍሊት)
    // ==========================================================
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      // Payment creation/approval is handled by Flask Admin SDK so the
      // browser cannot forge amount, status, uid, or approval timestamps.
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /entitlements/{userId} {
      allow read: if isAdmin() || isOwnProfile(userId);
      allow write: if false;
    }

    // ==========================================================
    // ⌨️ TYPING INDICATORS
    // ==========================================================
    match /typing/{className} {
      allow read: if isAuthenticated()
        && className == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.class;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([request.auth.uid]);
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if isAdmin();
    }

    // ==========================================================
    // 🏢 ORGANIZATION SETTINGS (ሎጎ)
    // ==========================================================
    match /organization/{docId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================================
    // 🎓 COURSES / TEACHER CONTENT
    // ==========================================================
    match /courses/{courseId} {
      // V31.108 Phase E security fix: this used to be `allow read: if
      // isAuthenticated()` - ANY signed-in student could read every course
      // document directly with the Firestore client SDK, completely
      // bypassing the server-side Learning Mode/Audience targeting added in
      // student_course_routes.py (Phase C) and targeting_access.py. A
      // Regular student could see, and read the contents of, courses
      // deliberately restricted to Distance/Scholarship/Competition.
      //
      // Confirmed no frontend file (student.js, teacher.js, admin.js) ever
      // reads this collection directly with the client SDK - every read
      // already goes through /api/teacher/courses or /api/student/courses.
      // So the safe fix is to stop allowing direct client reads at all and
      // let the backend (which enforces the real targeting rule) be the
      // only path, rather than trying to duplicate content_target_allowed()
      // inside a security rule.
      allow read: if isAdmin() || (isApprovedTeacher() && resource.data.teacherUid == request.auth.uid);
      allow create: if isAdmin() || (isApprovedTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow update, delete: if isAdmin() || (isApprovedTeacher() && resource.data.teacherUid == request.auth.uid);
    }
    match /lessons/{lessonId} {
      // Same fix, same reasoning as /courses above - a lesson document's
      // `url` field is the actual video/PDF link, so this was the more
      // serious half of the leak.
      //
      // V31.108 Interactive Lesson Builder: `blocks` (and its schema
      // version/count) may only be written by the server, which validates
      // and sanitises every block (URLs, text, GeoGebra ids) and keeps quiz
      // answer keys out of this document. A teacher's direct client write
      // therefore cannot add or alter blocks; admins are unaffected.
      allow read: if isAdmin() || (isApprovedTeacher() && resource.data.teacherUid == request.auth.uid);
      allow create: if isAdmin() || (isApprovedTeacher() && request.resource.data.teacherUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['blocks', 'blockSchemaVersion', 'blockCount']));
      allow update: if isAdmin() || (isApprovedTeacher() && resource.data.teacherUid == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['blocks', 'blockSchemaVersion', 'blockCount']));
      allow delete: if isAdmin() || (isApprovedTeacher() && resource.data.teacherUid == request.auth.uid);
    }
    // V31.108 Interactive Lesson Builder: quiz/practice answer keys and
    // per-student block results are server-only (Flask/Admin SDK). No client,
    // teacher or student, can read or write them.
    match /lessonBlockKeys/{lessonId} {
      allow read, write: if false;
    }
    match /lessonBlockResults/{resultId} {
      allow read, write: if false;
    }
    match /units/{unitId} {
      // V31.108 Course Structure Completion: new collection, same rule
      // shape (and same reasoning) as /courses and /lessons directly above
      // - direct client reads/writes are limited to the owning teacher (or
      // admin); every student read goes through the server, which already
      // applies the course's own targeting check before returning units.
      allow read: if isAdmin() || (isApprovedTeacher() && resource.data.teacherUid == request.auth.uid);
      allow create: if isAdmin() || (isApprovedTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow update, delete: if isAdmin() || (isApprovedTeacher() && resource.data.teacherUid == request.auth.uid);
    }

    // V31.108 Phase C/E: these two collections are written exclusively by
    // student_course_routes.py via the Admin SDK (which is not subject to
    // these rules at all), so `allow write: if false` here does not block
    // the app - it only blocks a client from writing its own fake progress
    // or certificate record directly. Read is scoped to the owning student
    // (or admin) in case a future page wants a live listener; today both
    // are read through /api/student/... instead.
    match /courseProgress/{progressId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.studentUid == request.auth.uid);
      allow write: if false;
    }
    match /courseCertificates/{certId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.studentUid == request.auth.uid);
      allow write: if false;
    }

    // ==========================================================
    // 📝 ADVANCED EXAMS
    // ==========================================================
    match /exams/{examId} {
      // V31.108 security fix: was `isAdmin() || (isAuthenticated() &&
      // status == 'published')` - ANY signed-in student could read ANY
      // published exam from ANY grade directly via the client SDK, with no
      // grade check at all. Confirmed no frontend file (student.js,
      // teacher.js, admin.js) ever reads this collection directly - the
      // real student path is GET /api/exams (app.py), which already
      // enforces className match server-side. So, matching the same fix
      // already applied to /courses and /lessons in this file: stop
      // allowing direct client reads for students entirely and let the
      // backend (which enforces the real grade rule) be the only path,
      // rather than duplicating that grade check inside a security rule.
      allow read: if isAdmin() || (isApprovedTeacher() && resource.data.teacherUid == request.auth.uid);
      allow create: if isAdmin() || (isAuthenticated() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.approved == true && request.resource.data.teacherUid == request.auth.uid);
      allow update, delete: if isAdmin() || (isAuthenticated() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.approved == true && resource.data.teacherUid == request.auth.uid);
    }
    match /examKeys/{examId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.teacherUid == request.auth.uid);
      allow create: if isAdmin() || (isAuthenticated() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.approved == true && request.resource.data.teacherUid == request.auth.uid);
      allow update, delete: if isAdmin() || (isAuthenticated() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.approved == true && resource.data.teacherUid == request.auth.uid);
    }
    match /examAttempts/{attemptId} {
      // Attempts are created, graded, and updated by Flask/Admin SDK.
      // The browser never writes authoritative attempt records directly.
      allow create: if false;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ==========================================================
    // ✅ CLASSROOM ATTENDANCE (Regular students only)
    // Written exclusively by attendance_routes.py via the Admin SDK, which
    // already enforces: approved-teacher-only, teacher-owns-this-grade-only,
    // and Regular-learningMode-only (a Distance student's UID is silently
    // skipped server-side, never written here). `allow write: if false`
    // blocks a client from writing/forging its own record directly; a
    // teacher's own view still goes through GET /api/teacher/attendance,
    // not a direct listener on this collection.
    // ==========================================================
    match /attendanceRecords/{recordId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.studentUid == request.auth.uid);
      allow write: if false;
    }


    // ==========================================================
    // 🔖 USER BOOKMARKS / FAVORITES
    // Each user may manage only their own saved learning items.
    // ==========================================================
    match /bookmarks/{userId} {
      allow read: if isOwnProfile(userId);
      allow create, update: if isOwnProfile(userId);
      allow delete: if isOwnProfile(userId);
    }

    // ==========================================================
    // 📚 NATIONAL EXAM ARCHIVE
    // Browser access is intentionally disabled. Flask Admin SDK
    // returns only items the authenticated student is entitled to see.
    // ==========================================================
    match /examArchives/{archiveId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 🔔 PUSH TOKENS / IN-APP NOTIFICATIONS
    // ==========================================================
    match /fcmTokens/{tokenId} {
      // Token registration is server-authoritative. Students never write raw FCM tokens directly.
      allow read, create, update, delete: if isAdmin();
    }
    match /notificationPreferences/{uid} {
      // Preferences are written through Flask so the server can enforce a stable schema.
      allow read, write: if false;
    }
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.targetUid == request.auth.uid || resource.data.targetUid == 'all');
      // Notifications are normally created by Flask/Admin SDK. Keep browser
      // creation limited to self-authored records for legacy compatibility.
      allow create: if false;
      // Recipients can mark only their own notification as read.
      allow update: if isAuthenticated()
        && resource.data.targetUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if isAdmin();
    }

    // AI Tutor knowledge base. Teacher ingestion is server-authoritative;
    // students do not need direct Firestore access to these collections.
    match /aiMaterials/{materialId} {
      allow read, write: if false;
    }
    match /aiMaterialChunks/{chunkId} {
      allow read, write: if false;
    }
    match /aiUsage/{usageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ==========================================================
    // 🎥 LIVE CLASSES / TEACHER PRESENCE / Q&A
    // Server-authoritative through Flask.
    // ==========================================================
    match /liveClasses/{classId} {
      // Students and teachers use Flask endpoints which enforce grade/ownership
      // and enrollment rules. Direct browser reads are disabled.
      allow read, write: if false;
    }
    match /teacherPresence/{teacherUid} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /liveClassQna/{qnaId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 👨‍👩‍👧 V30.30 PARENT RELATIONSHIPS & ANALYTICS
    // Browser access is intentionally disabled. Flask/Admin SDK verifies
    // the parent-child relationship before returning any child data.
    // ==========================================================
    match /parentChildLinks/{linkId} {
      allow read, write: if false;
    }
    match /studentAnalytics/{studentId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 💬 V25 COMMUNICATION & SUPPORT CENTER
    // All writes are server-authoritative through Flask.
    // ==========================================================
    match /supportTickets/{ticketId} {
      allow read, write: if false;
    }
    match /supportMessages/{messageId} {
      allow read, write: if false;
    }
    match /feedback/{feedbackId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 🛡️ V26 ADMIN AUDIT LOGS
    // Only the Flask/Admin SDK writes these records.
    // ==========================================================
    match /adminAuditLogs/{logId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 📚 V31.31 DIGITAL LIBRARY + ACADEMIC CHALLENGE
    // All authoritative reads/writes are performed through Flask/Admin SDK.
    // Keep these collections explicitly browser-denied even if the fallback
    // policy is changed in a future release.
    // ==========================================================
    match /questionBank/{questionId} {
      allow read, write: if false;
    }
    match /academicChallenges/{challengeId} {
      allow read, write: if false;
    }
    match /challengeAttempts/{attemptId} {
      allow read, write: if false;
    }
    match /practiceSessions/{sessionId} {
      allow read, write: if false;
    }
    match /studentProgression/{userId} {
      allow read, write: if false;
    }

    // V31.43: certificate records are server-only. Public verification uses Flask.
    match /awardLedger/{awardId}/certificate/{certificateId} {
      allow read, write: if false;
    }

    match /challengeEntries/{entryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /challengeAwards/{awardId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }
    // V31.42: award ledger is server-only. Students receive awards through server API.
    match /awardLedger/{awardId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 📦 FALLBACK — ካልእ ዘይተጠቕሰ ኮለክሽን
    // ==========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

